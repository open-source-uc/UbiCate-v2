NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_BASE_URL=
API_UBICATE_SECRET=
# En servidores que exigen TLS (Azure, RDS con rds.force_ssl) hay que agregar &sslmode=require:
# el CLI de Prisma negocia TLS solo, pero el runtime y el seed van por node-postgres, que sin
# sslmode conecta en claro y falla con un P1010 ("User was denied access") que despista.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/ubicate?schema=public"
NEXT_PUBLIC_IS_SELF_HOST="FALSE"
INDEX_PAGE="FALSE"
OUTBOUND_PROXY=
RUNTIME="nodejs"

# Cadencia de refetch del cliente (en segundos). Opcionales; defaults: 300 (online) / 30 (offline).
NEXT_PUBLIC_REFETCH_ONLINE_SECONDS="300"
NEXT_PUBLIC_REFETCH_OFFLINE_SECONDS="30"
# ¿Seguir refetcheando con la pestaña en segundo plano? "true" | "false" (default: false)
NEXT_PUBLIC_REFETCH_IN_BACKGROUND="false"

# Período de gracia tras el fin de un evento
# 86400 = 1 día.
NEXT_PUBLIC_EVENTS_GRACE_PERIOD="86400"
