{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "test:setup": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- prisma generate",
    "test": "dotenv -e .env.test -- vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./env.d.ts",
    "preview": "npm run lint:fix && npm run cf:preview"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-clockwise": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/turf": "^7.4.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.0",
    "ofetch": "^1.5.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-map-gl": "^8.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.32.2",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "serwist": "^9.5.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.122.0"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "glob": "9.3.5",
      "node-domexception": "1.0.0"
    },
    "overrides": {
      "postcss>nanoid": "^3.3.18"
    }
  }
}
