generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campus {
  id           String          @id @db.VarChar(100)
  name         String          @db.VarChar(255)
  shortName    String?         @db.VarChar(100)
  address      String?         @db.VarChar(500)
  information  String?
  category     String?         @db.VarChar(100)
  geometryType GeoGeometryType
  geometry     Json
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  events       Event[]
  places       Place[]
  routes       Route[]

  @@map("campus")
}

model Place {
  id            String          @id @db.VarChar(150)
  name          String          @db.VarChar(500)
  information   String?
  needApproval  Boolean         @default(false)
  proposalType  ProposalType?
  campusId      String?         @db.VarChar(100)
  parentPlaceId String?         @db.VarChar(150)
  geometryType  GeoGeometryType
  geometry      Json
  longitude     Decimal?        @db.Decimal(12, 8)
  latitude      Decimal?        @db.Decimal(12, 8)
  isEventOnly   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  eventLinks    EventPlace[]
  routeLinks    RoutePlace[]
  campus        Campus?         @relation(fields: [campusId], references: [id])
  parentPlace   Place?          @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id])
  childPlaces   Place[]         @relation("PlaceHierarchy")
  categories    PlaceCategory[]
  floors        PlaceFloor[]

  @@index([campusId])
  @@index([parentPlaceId])
  @@index([name])
  @@index([geometryType])
  @@index([needApproval])
  @@index([isEventOnly])
  @@index([updatedAt])
  @@map("place")
}

model Category {
  id        String          @id @db.VarChar(100)
  name      String?         @db.VarChar(255)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  places    PlaceCategory[]

  @@map("category")
}

model Floor {
  id        Int          @id
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  places    PlaceFloor[]

  @@map("floor")
}

model PlaceCategory {
  placeId    String   @db.VarChar(150)
  categoryId String   @db.VarChar(100)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([categoryId])
  @@map("place_category")
}

model PlaceFloor {
  placeId String @db.VarChar(150)
  floorId Int
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, floorId])
  @@index([floorId])
  @@map("place_floor")
}

model Event {
  id           String          @id @db.VarChar(150)
  name         String          @db.VarChar(500)
  information  String?
  campusId     String?         @db.VarChar(100)
  geometryType GeoGeometryType
  geometry     Json
  longitude    Decimal?        @db.Decimal(12, 8)
  latitude     Decimal?        @db.Decimal(12, 8)
  categories   String[]
  floors       Int[]
  startDate    DateTime
  endDate      DateTime
  showFrom     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campus       Campus?         @relation(fields: [campusId], references: [id])
  places       EventPlace[]

  @@index([campusId])
  @@index([startDate])
  @@index([endDate])
  @@map("event")
}

model EventPlace {
  eventId String @db.VarChar(150)
  placeId String @db.VarChar(150)
  floor   Int?
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([eventId, placeId])
  @@index([placeId])
  @@map("event_place")
}

model Route {
  id           String          @id @db.VarChar(150)
  name         String          @db.VarChar(500)
  information  String?
  campusId     String?         @db.VarChar(100)
  // Hex "#rrggbb" con el que se dibuja la ruta. Null = el verde por defecto; el borde se deriva
  // oscureciéndolo, no se guarda.
  color        String?         @db.VarChar(7)
  geometryType GeoGeometryType
  geometry     Json
  longitude    Decimal?        @db.Decimal(12, 8)
  latitude     Decimal?        @db.Decimal(12, 8)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campus       Campus?         @relation(fields: [campusId], references: [id])
  places       RoutePlace[]

  @@index([campusId])
  @@map("route")
}

// Sin columna de orden a propósito: los lugares de una ruta son un conjunto, no una secuencia.
// Agregar `position Int` después es aditivo y no cambia la PK.
model RoutePlace {
  routeId String @db.VarChar(150)
  placeId String @db.VarChar(150)
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([routeId, placeId])
  @@index([placeId])
  @@map("route_place")
}

enum GeoGeometryType {
  Point
  Polygon
  MultiPolygon
  LineString
}

enum ProposalType {
  edit
}
